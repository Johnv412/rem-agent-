<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- RemAgent weekly decay: Sundays 03:00, Ebbinghaus pruning of
         long-dormant low-confidence facts. Failures exit non-zero and
         persist nothing (per the CLI contract) and show in the log. -->
    <key>Label</key>
    <string>com.remagent.decay</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>source /Users/test/.remagent/env; echo "--- $(date '+%Y-%m-%d %H:%M:%S') decay pass ---"; /Library/Frameworks/Python.framework/Versions/3.11/bin/remagent decay --agent john --db /Users/test/.remagent/memory.db</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/test/.remagent/logs/decay.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/test/.remagent/logs/decay.log</string>
</dict>
</plist>
